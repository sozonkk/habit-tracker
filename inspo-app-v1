            border: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        
        .day-cell.completed {
            background: var(--success-muted);
            border-color: var(--success);
        }
        
        .day-cell.completed::after {
            content: '';
            position: absolute;
            width: 6px;
            height: 6px;
            background: var(--success);
            border-radius: 50%;
        }
        
        .day-cell.today {
            border-color: var(--accent);
        }
        
        .progress-bar-wrapper {
            margin-bottom: var(--space-3);
        }
        
        .progress-bar-container {
            height: 6px;
            background: var(--bg-tertiary);
            border-radius: var(--radius-sm);
            overflow: hidden;
            margin-bottom: var(--space-2);
        }
        
        .progress-bar-fill {
            height: 100%;
            background: var(--accent);
            border-radius: var(--radius-sm);
            transition: width 0.3s ease;
        }
        
        .week-stats {
            display: flex;
            justify-content: space-between;
            font-size: var(--text-sm);
            color: var(--text-secondary);
        }
        
        .week-stats strong {
            color: var(--text-primary);
            font-weight: var(--weight-medium);
        }
        
        /* ============================================
           TODAY'S WORKOUT
           ============================================ */
        .workout-card {
            background: var(--bg-secondary);
            border: 1px solid var(--border-emphasis);
            border-radius: var(--radius-lg);
            padding: var(--space-4);
            margin-bottom: var(--space-4);
            position: relative;
        }
        
        .workout-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: var(--space-4);
            bottom: var(--space-4);
            width: 3px;
            background: var(--accent);
            border-radius: 0 2px 2px 0;
        }
        
        .workout-header {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            margin-bottom: var(--space-3);
            padding-left: var(--space-3);
        }
        
        .workout-icon {
            width: 40px;
            height: 40px;
            background: var(--accent-muted);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .workout-icon svg {
            width: 20px;
            height: 20px;
            fill: var(--accent);
        }
        
        .workout-info h3 {
            font-size: var(--text-lg);
            font-weight: var(--weight-semibold);
            margin-bottom: 2px;
            letter-spacing: -0.3px;
        }
        
        .workout-meta {
            font-size: var(--text-sm);
            color: var(--text-secondary);
        }
        
        .start-button {
            width: 100%;
            padding: var(--space-3) var(--space-4);
            background: var(--accent);
            color: white;
            border: none;
            border-radius: var(--radius-md);
            font-size: var(--text-base);
            font-weight: var(--weight-medium);
            cursor: pointer;
            transition: background 0.2s ease;
            margin-left: var(--space-3);
        }
        
        .start-button:hover {
            background: var(--accent-hover);
        }
        
        .start-button:active {
            transform: scale(0.98);
        }
        
        /* ============================================
           RECENT WORKOUTS
           ============================================ */
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--space-4);
        }
        
        .section-title {
            font-size: var(--text-lg);
            font-weight: var(--weight-semibold);
            letter-spacing: -0.3px;
        }
        
        .view-all {
            font-size: var(--text-sm);
            color: var(--accent);
            text-decoration: none;
            font-weight: var(--weight-medium);
            display: flex;
            align-items: center;
            gap: var(--space-1);
        }
        
        .recent-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: var(--space-4);
            background: var(--bg-secondary);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-md);
            margin-bottom: var(--space-2);
            transition: border-color 0.2s ease;
        }
        
        .recent-item:hover {
            border-color: var(--border-emphasis);
        }
        
        .recent-left {
            display: flex;
            align-items: center;
            gap: var(--space-3);
        }
        
        .exercise-icon {
            width: 32px;
            height: 32px;
            background: var(--bg-tertiary);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .exercise-icon svg {
            width: 16px;
            height: 16px;
            fill: var(--text-secondary);
        }
        
        .exercise-name {
            font-size: var(--text-base);
            font-weight: var(--weight-medium);
            margin-bottom: 2px;
        }
        
        .exercise-stats {
            font-size: var(--text-sm);
            color: var(--text-secondary);
            font-family: var(--font-mono);
        }
        
        .recent-date {
            font-size: var(--text-xs);
            color: var(--text-tertiary);
            font-weight: var(--weight-medium);
        }
        
        /* ============================================
           BOTTOM NAVIGATION
           ============================================ */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: var(--bg-secondary);
            border-top: 1px solid var(--border-default);
            backdrop-filter: blur(10px);
            z-index: 100;
        }
        
        .nav-container {
            max-width: 640px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            padding: var(--space-2) 0;
        }
        
        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: var(--space-1);
            text-decoration: none;
            color: var(--text-tertiary);
            transition: color 0.2s ease;
            padding: var(--space-2);
        }
        
        .nav-item:hover {
            color: var(--text-secondary);
        }
        
        .nav-item.active {
            color: var(--accent);
        }
        
        .nav-icon {
            width: 24px;
            height: 24px;
        }
        
        .nav-icon svg {
            width: 100%;
            height: 100%;
            fill: currentColor;
        }
        
        .nav-label {
            font-size: var(--text-xs);
            font-weight: var(--weight-medium);
        }
        
        /* ============================================
           RESPONSIVE
           ============================================ */
        @media (max-width: 640px) {
            .container {
                padding: var(--space-3);
            }
            
            .header {
                margin-bottom: var(--space-4);
            }
        }
    </style>
</head>
